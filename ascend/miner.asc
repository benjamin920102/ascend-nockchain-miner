#include <cstdlib>
#include <cstring>
#include <iostream>
#include <new>
#include <stdint.h>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"

constexpr int OK=0, ERR_ARG=-1, ERR_SHAPE=-2, ERR_RUNTIME=-3, ERR_ALLOC=-4;
constexpr int H=8, W=8, K=1024, RANK=64, STEPS=K/RANK, PM=16, PN=32, WORDS=16;
constexpr size_t PACK_BYTES=(size_t)STEPS*PM*RANK;
constexpr size_t PART_BYTES=(size_t)STEPS*PM*PN*sizeof(int32_t);

__global__ __cube__ void mm_kernel(__gm__ int8_t *a, __gm__ int8_t *b, __gm__ int32_t *c,
    __gm__ uint8_t *workspace, AscendC::tiling::TCubeTiling tiling) {
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<int8_t> ag,bg; AscendC::GlobalTensor<int32_t> cg;
    ag.SetGlobalBuffer(a); bg.SetGlobalBuffer(b); cg.SetGlobalBuffer(c);
    matmul::Matmul<
        matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,int8_t,false>,
        matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,int8_t,true>,
        matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,int32_t>> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    mm.SetOrgShape(PM,PN,RANK,RANK);
    for (int s=0;s<STEPS;++s) {
        uint64_t ab=(uint64_t)s*PM*RANK, cb=(uint64_t)s*PM*PN;
        mm.SetTensorA(ag[ab],false); mm.SetTensorB(bg[ab],true); mm.IterateAll(cg[cb]);
    }
    mm.End();
}

__aicore__ inline uint32_t rotl13(uint32_t x) { return (x<<13)|(x>>19); }
__global__ __vector__ void fold_kernel(__gm__ int32_t *parts, __gm__ int32_t *out) {
    if (AscendC::GetBlockIdx()!=0) return;
    uint32_t acc[PM*PN]={0}, state[WORDS]={0};
    for (int s=0;s<STEPS;++s) {
        uint32_t x=0; int64_t base=(int64_t)s*PM*PN;
        for (int u=0;u<H;++u) for (int v=0;v<W;++v) {
            int p=u*PN+v; acc[p]+=(uint32_t)parts[base+p]; x^=acc[p];
        }
        int slot=s&15; state[slot]=rotl13(state[slot])^x;
    }
    for (int i=0;i<WORDS;++i) out[i]=(int32_t)state[i];
    dcci((__gm__ int32_t*)out, cache_line_t::SINGLE_CACHE_LINE, dcci_dst_t::CACHELINE_OUT);
}

static AscendC::tiling::TCubeTiling make_tiling(platform_ascendc::PlatformAscendC *p) {
    AscendC::tiling::TCubeTiling t; matmul_tiling::MultiCoreMatmulTiling api(*p);
    api.SetDim(1);
    api.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8,false);
    api.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8,true);
    api.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT32);
    api.SetOrgShape(PM,PN,RANK,RANK); api.SetShape(PM,PN,RANK); api.SetFixSplit(PM,PN,-1);
    api.EnableBias(false); api.SetBufferSpace(-1,-1,-1);
    if (api.GetTiling(t)==-1) std::cerr << "[ascend-miner] tiling failed\n";
    return t;
}

struct ascend_miner_ctx {
    int device=0; aclrtStream stream=nullptr; AscendC::tiling::TCubeTiling tiling;
    int8_t *ad=nullptr,*bd=nullptr,*ah=nullptr,*bh=nullptr;
    int32_t *parts=nullptr,*sd=nullptr,*sh=nullptr; uint8_t *workspace=nullptr; size_t workspace_bytes=0;
};

extern "C" void ascend_miner_destroy(ascend_miner_ctx *c);
static void pack(const int8_t *src, int rows, int8_t *dst) {
    std::memset(dst,0,PACK_BYTES);
    for(int s=0;s<STEPS;++s) for(int r=0;r<rows;++r)
        std::memcpy(dst+((size_t)s*PM+r)*RANK, src+(size_t)r*K+(size_t)s*RANK, RANK);
}

extern "C" int ascend_miner_is_hardware(void) { return 1; }
extern "C" int ascend_miner_create(int device, ascend_miner_ctx **out) {
    if(!out||device<0) return ERR_ARG;
    aclError e=aclInit(nullptr); if(e!=ACL_SUCCESS && e!=ACL_ERROR_REPEAT_INITIALIZE) return ERR_RUNTIME;
    auto *c=new(std::nothrow) ascend_miner_ctx(); if(!c) return ERR_ALLOC; c->device=device;
    if(aclrtSetDevice(device)!=ACL_SUCCESS || aclrtCreateStream(&c->stream)!=ACL_SUCCESS) { delete c; return ERR_RUNTIME; }
    auto p=platform_ascendc::PlatformAscendCManager::GetInstance(); c->tiling=make_tiling(p); c->workspace_bytes=p->GetLibApiWorkSpaceSize();
    if(aclrtMalloc((void**)&c->ad,PACK_BYTES,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS ||
       aclrtMalloc((void**)&c->bd,PACK_BYTES,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS ||
       aclrtMalloc((void**)&c->parts,PART_BYTES,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS ||
       aclrtMalloc((void**)&c->sd,WORDS*sizeof(int32_t),ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS ||
       aclrtMalloc((void**)&c->workspace,c->workspace_bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS ||
       aclrtMallocHost((void**)&c->ah,PACK_BYTES)!=ACL_SUCCESS || aclrtMallocHost((void**)&c->bh,PACK_BYTES)!=ACL_SUCCESS ||
       aclrtMallocHost((void**)&c->sh,WORDS*sizeof(int32_t))!=ACL_SUCCESS) { ascend_miner_destroy(c); return ERR_ALLOC; }
    *out=c; return OK;
}

extern "C" int ascend_miner_tile_state(ascend_miner_ctx *c,const int8_t *a,const int8_t *b,
    uint32_t h,uint32_t w,uint32_t k,uint32_t rank,uint32_t dot_len,int32_t out[16]) {
    if(!c||!a||!b||!out) return ERR_ARG;
    if(h!=H||w!=W||k!=K||rank!=RANK||dot_len!=K) return ERR_SHAPE;
    if(aclrtSetDevice(c->device)!=ACL_SUCCESS) return ERR_RUNTIME;
    pack(a,H,c->ah); pack(b,W,c->bh);
    if(aclrtMemcpyAsync(c->ad,PACK_BYTES,c->ah,PACK_BYTES,ACL_MEMCPY_HOST_TO_DEVICE,c->stream)!=ACL_SUCCESS ||
       aclrtMemcpyAsync(c->bd,PACK_BYTES,c->bh,PACK_BYTES,ACL_MEMCPY_HOST_TO_DEVICE,c->stream)!=ACL_SUCCESS) return ERR_RUNTIME;
    mm_kernel<<<1,nullptr,c->stream>>>(c->ad,c->bd,c->parts,c->workspace,c->tiling);
    fold_kernel<<<1,nullptr,c->stream>>>(c->parts,c->sd);
    if(aclrtMemcpyAsync(c->sh,WORDS*sizeof(int32_t),c->sd,WORDS*sizeof(int32_t),ACL_MEMCPY_DEVICE_TO_HOST,c->stream)!=ACL_SUCCESS ||
       aclrtSynchronizeStream(c->stream)!=ACL_SUCCESS) return ERR_RUNTIME;
    std::memcpy(out,c->sh,WORDS*sizeof(int32_t)); return OK;
}

extern "C" void ascend_miner_destroy(ascend_miner_ctx *c) {
    if(!c) return; aclrtSetDevice(c->device);
    if(c->ad) aclrtFree(c->ad); if(c->bd) aclrtFree(c->bd); if(c->parts) aclrtFree(c->parts);
    if(c->sd) aclrtFree(c->sd); if(c->workspace) aclrtFree(c->workspace);
    if(c->ah) aclrtFreeHost(c->ah); if(c->bh) aclrtFreeHost(c->bh); if(c->sh) aclrtFreeHost(c->sh);
    if(c->stream) aclrtDestroyStream(c->stream); delete c;
}

extern "C" const char *ascend_miner_error_string(int code) {
    switch(code) { case OK:return "ok"; case ERR_ARG:return "invalid argument"; case ERR_SHAPE:return "v0 expects h=w=8,k=1024,rank=64";
        case ERR_RUNTIME:return "CANN runtime failure"; case ERR_ALLOC:return "allocation failure"; default:return "unknown Ascend error"; }
}
